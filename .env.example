# ── Groq (optional) ─────────────────────────────────────────────────────────
# Without GROQ_API_KEY the app uses deterministic grounded fallback responses.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ROUTER_MODEL=llama-3.1-8b-instant

# ── Google Sheets source ─────────────────────────────────────────────────────
# Default public sheet loads 448 wine records. Fill in values as needed.
GOOGLE_SHEETS_ID=1Bkv3Jb_8YuLUG2rWUhJhQBdaGjQCMFfwF9oJ5jrYDSA
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
WINE_DATA_CSV_URL=
WINE_DATA_JSON_URL=

# ── ChromaDB (Next.js RAG layer) ─────────────────────────────────────────────
CHROMA_URL=http://localhost:8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_COLLECTION=sommelier_wines
CHROMA_API_KEY=
CHROMA_INGEST_BATCH_SIZE=100
RAG_TOP_K=6
RAG_DEBUG=false
ROUTER_MODE=

# ── Postgres + pgvector (Express API layer) ──────────────────────────────────
# Used by Prisma and the seed script. The pgvector extension must be enabled.
DATABASE_URL=postgresql://sommelier:sommelier@localhost:5432/sommelier_ai

# ── Express API server ───────────────────────────────────────────────────────
PORT=4000

# ── Embedding dimensions ─────────────────────────────────────────────────────
# @chroma-core/default-embed produces 384-dimensional vectors.
EMBED_DIM=384

# ── Spoonacular food API ─────────────────────────────────────────────────────
FOOD_API_KEY=
FOOD_API_TIMEOUT_MS=6000

# ── Admin / evaluation ───────────────────────────────────────────────────────
ADMIN_API_TOKEN=
EVALUATION_PORT=3100
EVALUATION_OUTPUT=evaluation-report.json
EVALUATION_SKIP_INGEST=false
